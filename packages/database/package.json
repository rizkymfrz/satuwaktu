    "eslint": "^9.39.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
